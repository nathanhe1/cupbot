# Copy to .env and fill in. .env is git-ignored.
SUPERMARKET_API_KEY=
ANTHROPIC_API_KEY=
# optional: Kalshi key enables websocket streaming (REST polling works without it)
KALSHI_API_KEY=
# phone alerts + kill switch (see cupbot/notify.py); pick long random strings
NTFY_TOPIC=
NTFY_CMD_TOKEN=
# on the server: empty = dry run, --live = real orders (config must also allow it)
CUPBOT_ARGS=
